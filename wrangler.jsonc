// Cloudflare Workers の静的アセットとして public/ を公開する
// 公開:  npx wrangler deploy
// 独自ドメイン: ドメインを Cloudflare に追加したあと、routes のコメントを外す
{
  "name": "dara-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
  // "routes": [{ "pattern": "example.com", "custom_domain": true }]
}
