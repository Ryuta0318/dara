// DARA アプリ本体（友達だけのスレッドSNS）
//   cd app && npx wrangler deploy
{
  "name": "dara-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker で処理する
    "run_worker_first": ["/api/*"]
  },
  // 通報を見られる人のユーザーID（カンマ区切り）。自分のIDを入れる
  "vars": { "ADMIN_HANDLES": "" },
  // 写真・動画の置き場（Cloudflare R2）。先に1回だけ: npx wrangler r2 bucket create dara-media
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dara-media" }],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
