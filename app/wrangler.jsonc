// DARA アプリ本体（友達だけのスレッドSNS）
//   cd app && npx wrangler deploy
{
  "name": "dara-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker で処理する
    "run_worker_first": ["/api/*"]
  },
  // 通報を見られる人のユーザーID（カンマ区切り）。自分のIDを入れる
  "vars": { "ADMIN_HANDLES": "" },
  // 写真・動画は、いまは Durable Object のデータベースに保存している（無料で約 5GB）。
  // 外付けの置き場（Cloudflare R2）に移すときは、R2 を有効にして
  //   npx wrangler r2 bucket create dara-media
  // を1回だけ実行し、次の行の // を外してデプロイする（入っている写真も自動で少しずつ移る）
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dara-media" }],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
